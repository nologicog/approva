generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum ApprovalRequestStatus {
  pending
  approved
  rejected
  expired
  auto_approved
}

enum ApprovalDecisionType {
  approved
  rejected
  auto_approved
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
}

enum ApproverUserStatus {
  active
  disabled
}

enum OrganizationMemberRole {
  owner
  admin
  member
  approver
}

enum IntegrationType {
  slack
  webhook
  email
}

enum ApiKeyScope {
  approval_requests_create
  approval_requests_read
  capabilities_verify
  capabilities_use
  webhooks_manage
}

enum CapabilityDeliveryMode {
  none
  exchange_token
}

enum MachinePrincipalType {
  api_key
  service_account
}

model Organization {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  createdAt         DateTime            @default(now()) @map("created_at")
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at")
  ownerUserId       String?             @map("owner_user_id")
  ownerUser         User?               @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  activeUsers       User[]              @relation("ActiveOrganization")
  members           OrganizationMember[]
  invitations       OrganizationInvitation[]
  approvalRequests  ApprovalRequest[]
  approvalDecisions ApprovalDecision[]
  capabilities      Capability[]
  capabilityExchangeTokens CapabilityExchangeToken[]
  auditEvents       AuditEvent[]
  immutableEvents   ImmutableEvent[]
  ledgerEntries     LedgerEntry[]
  webhookDeliveries WebhookDelivery[]
  policies          Policy[]
  webhookEndpoints  WebhookEndpoint[]
  integrations      Integration[]
  serviceAccounts   ServiceAccount[]
  apiKeys           OrganizationApiKey[]
  subscription      OrganizationSubscription?
  stripeWebhookEventReceipts StripeWebhookEventReceipt[]
  webhookReplayWindows WebhookReplayWindow[]

  @@index([createdAt], map: "organizations_created_at_idx")
  @@index([ownerUserId, createdAt], map: "organizations_owner_user_id_created_at_idx")
  @@map("organizations")
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  userId         String                 @map("user_id")
  role           OrganizationMemberRole
  createdAt      DateTime               @default(now()) @map("created_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "organization_members_organization_id_user_id_key")
  @@index([userId, createdAt], map: "organization_members_user_id_created_at_idx")
  @@index([organizationId, role, createdAt], map: "organization_members_organization_id_role_created_at_idx")
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  email          String
  role           OrganizationMemberRole
  invitedByUserId String?               @map("invited_by_user_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  expiresAt      DateTime               @map("expires_at")
  acceptedAt     DateTime?              @map("accepted_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByUser  User?                  @relation("OrganizationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email], map: "organization_invitations_organization_id_email_key")
  @@index([email, acceptedAt, expiresAt], map: "organization_invitations_email_accepted_expires_idx")
  @@index([organizationId, createdAt], map: "organization_invitations_organization_id_created_at_idx")
  @@map("organization_invitations")
}

model ApprovalRequest {
  organizationId         String                @map("organization_id")
  id                String                @id @default(uuid()) @db.Uuid
  externalRequestId String?               @map("external_request_id")
  requestedBySystem String                @map("requested_by_system")
  requestedByActorId String?              @map("requested_by_actor_id")
  idempotencyKey    String?               @map("idempotency_key")
  requestFingerprintHash String           @db.Char(64) @map("request_fingerprint_hash")
  approvalAccessTokenHash String          @unique @db.Char(64) @map("approval_access_token_hash")
  action            String
  resourceType      String                @map("resource_type")
  resourceId        String                @map("resource_id")
  params            Json
  paramsHash        String                @db.Char(64) @map("params_hash")
  riskLevel         RiskLevel             @map("risk_level")
  status            ApprovalRequestStatus
  callbackUrl       String?               @map("callback_url")
  deliverCapabilityMode CapabilityDeliveryMode @default(none) @map("deliver_capability_mode")
  machinePrincipalType MachinePrincipalType? @map("machine_principal_type")
  machinePrincipalId String?              @map("machine_principal_id")
  policyResult      Json                  @map("policy_result")
  expiresAt         DateTime              @map("expires_at")
  decidedAt         DateTime?             @map("decided_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decision          ApprovalDecision?
  capability        Capability?
  capabilityExchangeToken CapabilityExchangeToken?
  auditEvents       AuditEvent[]
  immutableEvents   ImmutableEvent[]
  webhookDeliveries WebhookDelivery[]

  @@index([organizationId, status, expiresAt], map: "approval_requests_org_status_expires_idx")
  @@index([organizationId, resourceType, resourceId, createdAt], map: "approval_requests_org_resource_created_idx")
  @@index([organizationId, requestedBySystem, createdAt], map: "approval_requests_org_system_created_idx")
  @@index([organizationId, createdAt], map: "approval_requests_org_created_idx")
  @@unique([organizationId, requestedBySystem, idempotencyKey], map: "approval_requests_org_system_idemp_key")
  @@unique([organizationId, requestedBySystem, externalRequestId], map: "approval_requests_org_system_external_key")
  @@map("approval_requests")
}

model ApprovalDecision {
  organizationId       String               @map("organization_id")
  id                  String               @id @default(uuid()) @db.Uuid
  approvalRequestId   String               @db.Uuid @map("approval_request_id")
  decision            ApprovalDecisionType
  approverId          String               @map("approver_id")
  approverDisplayName String?              @map("approver_display_name")
  reason              String?
  authMethod          String               @map("auth_method")
  authContext         Json?                @map("auth_context")
  createdAt           DateTime             @default(now()) @map("created_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest     ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@unique([approvalRequestId], map: "approval_decisions_approval_request_id_key")
  @@index([organizationId, approverId, createdAt], map: "approval_decisions_organization_id_approver_id_created_at_idx")
  @@map("approval_decisions")
}

model Capability {
  organizationId    String           @map("organization_id")
  id                String           @id @default(uuid()) @db.Uuid
  approvalRequestId String           @db.Uuid @map("approval_request_id")
  action            String
  resourceType      String           @map("resource_type")
  resourceId        String           @map("resource_id")
  paramsHash        String           @db.Char(64) @map("params_hash")
  tokenHash         String           @unique @db.Char(64) @map("token_hash")
  expiresAt         DateTime         @map("expires_at")
  issuedAt          DateTime         @default(now()) @map("issued_at")
  revokedAt         DateTime?        @map("revoked_at")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest   ApprovalRequest  @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  exchangeToken     CapabilityExchangeToken?

  @@unique([approvalRequestId], map: "capabilities_approval_request_id_key")
  @@index([organizationId, expiresAt], map: "capabilities_organization_id_expires_at_idx")
  @@index([organizationId, revokedAt], map: "capabilities_organization_id_revoked_at_idx")
  @@index([organizationId, resourceType, resourceId], map: "capabilities_organization_id_resource_type_resource_id_idx")
  @@map("capabilities")
}

model CapabilityExchangeToken {
  organizationId          String               @map("organization_id")
  id                      String               @id @default(uuid()) @db.Uuid
  approvalRequestId       String               @unique @db.Uuid @map("approval_request_id")
  capabilityId            String               @unique @db.Uuid @map("capability_id")
  exchangeTokenHash       String               @unique @db.Char(64) @map("exchange_token_hash")
  encryptedCapabilityToken String?             @map("encrypted_capability_token")
  callbackUrl             String?              @map("callback_url")
  machinePrincipalType    MachinePrincipalType? @map("machine_principal_type")
  machinePrincipalId      String?              @map("machine_principal_id")
  expiresAt               DateTime             @map("expires_at")
  usedAt                  DateTime?            @map("used_at")
  revokedAt               DateTime?            @map("revoked_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest         ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  capability              Capability           @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt], map: "capability_exchange_tokens_org_expires_idx")
  @@index([organizationId, usedAt, expiresAt], map: "capability_exchange_tokens_org_used_expires_idx")
  @@map("capability_exchange_tokens")
}

model AuditEvent {
  organizationId     String           @map("organization_id")
  id                String           @id @default(uuid()) @db.Uuid
  approvalRequestId String?          @db.Uuid @map("approval_request_id")
  eventType         String           @map("event_type")
  actorType         String           @map("actor_type")
  actorId           String?          @map("actor_id")
  payload           Json
  createdAt         DateTime         @default(now()) @map("created_at")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([organizationId, approvalRequestId, createdAt], map: "audit_events_organization_id_approval_request_id_created_at_idx")
  @@index([organizationId, eventType, createdAt], map: "audit_events_organization_id_event_type_created_at_idx")
  @@map("audit_events")
}

model ImmutableEvent {
  organizationId     String           @map("organization_id")
  id                String           @id @default(uuid()) @db.Uuid
  approvalRequestId String?          @db.Uuid @map("approval_request_id")
  eventType         String           @map("event_type")
  payload           Json
  payloadHash       String           @db.Char(64) @map("payload_hash")
  createdAt         DateTime         @default(now()) @map("created_at")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  ledgerEntry       LedgerEntry?

  @@index([organizationId, approvalRequestId, createdAt], map: "immutable_events_org_request_created_idx")
  @@index([organizationId, eventType, createdAt], map: "immutable_events_organization_id_event_type_created_at_idx")
  @@map("immutable_events")
}

model LedgerEntry {
  organizationId   String         @map("organization_id")
  id               String         @id @default(uuid()) @db.Uuid
  immutableEventId String         @unique @db.Uuid @map("immutable_event_id")
  sequence         Int
  previousHash     String?        @db.Char(64) @map("previous_hash")
  entryHash        String         @unique @db.Char(64) @map("entry_hash")
  createdAt        DateTime       @default(now()) @map("created_at")
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  immutableEvent   ImmutableEvent @relation(fields: [immutableEventId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sequence], map: "ledger_entries_organization_id_sequence_key")
  @@index([organizationId, createdAt], map: "ledger_entries_organization_id_created_at_idx")
  @@map("ledger_entries")
}

model WebhookDelivery {
  organizationId     String                @map("organization_id")
  id                String                @id @default(uuid()) @db.Uuid
  approvalRequestId String                @db.Uuid @map("approval_request_id")
  callbackUrl       String                @map("callback_url")
  eventType         String                @map("event_type")
  status            WebhookDeliveryStatus @default(pending)
  attemptCount      Int                   @default(0) @map("attempt_count")
  lastAttemptAt     DateTime?             @map("last_attempt_at")
  responseStatus    Int?                  @map("response_status")
  responseBody      String?               @map("response_body")
  createdAt         DateTime              @default(now()) @map("created_at")
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest   ApprovalRequest       @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@unique([approvalRequestId, eventType], map: "webhook_deliveries_approval_request_id_event_type_key")
  @@index([organizationId, status, createdAt], map: "webhook_deliveries_organization_id_status_created_at_idx")
  @@index([organizationId, approvalRequestId, createdAt], map: "webhook_deliveries_org_request_created_idx")
  @@map("webhook_deliveries")
}

model Policy {
  id               String                   @id @default(cuid())
  organizationId   String                   @map("organization_id")
  action           String
  resourceType     String                   @map("resource_type")
  riskLevel        RiskLevel                @map("risk_level")
  approvalRequired Boolean                  @map("approval_required")
  approverRoles    OrganizationMemberRole[] @map("approver_roles")
  createdAt        DateTime                 @default(now()) @map("created_at")
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, action, resourceType, riskLevel], map: "policies_org_action_resource_risk_key")
  @@index([organizationId, createdAt], map: "policies_org_created_idx")
  @@index([organizationId, action, resourceType, riskLevel], map: "policies_org_match_idx")
  @@map("policies")
}

model WebhookEndpoint {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  name              String
  callbackUrl       String       @map("callback_url")
  signingSecretHash String?      @db.Char(64) @map("signing_secret_hash")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, callbackUrl], map: "webhooks_organization_id_callback_url_key")
  @@index([organizationId, createdAt], map: "webhooks_organization_id_created_at_idx")
  @@map("webhooks")
}

model Integration {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  type           IntegrationType
  configJson     Json            @map("config_json")
  createdAt      DateTime        @default(now()) @map("created_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type], map: "integrations_org_type_key")
  @@index([organizationId, createdAt], map: "integrations_org_created_idx")
  @@map("integrations")
}

model BetaWaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  company   String
  useCase   String   @map("use_case")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "beta_waitlist_created_at_idx")
  @@map("beta_waitlist")
}

model RateLimitWindow {
  id          String   @id @default(cuid())
  scope       String
  bucket      String
  windowStart DateTime @map("window_start")
  count       Int      @default(1)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([scope, bucket, windowStart], map: "rate_limit_windows_scope_bucket_window_start_key")
  @@index([expiresAt], map: "rate_limit_windows_expires_at_idx")
  @@map("rate_limit_windows")
}

model WebhookReplayWindow {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  target           String
  replayKey        String       @db.Char(64) @map("replay_key")
  eventType        String       @map("event_type")
  approvalRequestId String?     @db.Uuid @map("approval_request_id")
  expiresAt        DateTime     @map("expires_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, target, replayKey], map: "webhook_replay_windows_org_target_replay_key_key")
  @@index([expiresAt], map: "webhook_replay_windows_expires_at_idx")
  @@index([organizationId, createdAt], map: "webhook_replay_windows_org_created_idx")
  @@map("webhook_replay_windows")
}

model ApproverUser {
  id                             String              @id @default(uuid()) @db.Uuid
  email                          String              @unique
  displayName                    String              @map("display_name")
  status                         ApproverUserStatus  @default(active)
  registrationChallenge          String?             @map("registration_challenge")
  registrationChallengeExpiresAt DateTime?           @map("registration_challenge_expires_at")
  authenticationChallenge        String?             @map("authentication_challenge")
  authenticationChallengeExpiresAt DateTime?         @map("authentication_challenge_expires_at")
  createdAt                      DateTime            @default(now()) @map("created_at")
  updatedAt                      DateTime            @updatedAt @map("updated_at")
  credentials                    WebauthnCredential[]
  sessions                       ApproverSession[]

  @@index([status, createdAt], map: "approver_users_status_created_at_idx")
  @@map("approver_users")
}

model WebauthnCredential {
  id             String        @id @default(uuid()) @db.Uuid
  approverUserId String        @db.Uuid @map("approver_user_id")
  credentialId   String        @unique @map("credential_id")
  publicKey      Bytes         @map("public_key")
  counter        Int
  transportsJson Json?         @map("transports_json")
  deviceType     String?       @map("device_type")
  backedUp       Boolean?      @map("backed_up")
  createdAt      DateTime      @default(now()) @map("created_at")
  lastUsedAt     DateTime?     @map("last_used_at")
  approverUser   ApproverUser  @relation(fields: [approverUserId], references: [id], onDelete: Cascade)
  sessions       ApproverSession[]

  @@index([approverUserId, createdAt], map: "webauthn_credentials_approver_user_id_created_at_idx")
  @@index([lastUsedAt], map: "webauthn_credentials_last_used_at_idx")
  @@map("webauthn_credentials")
}

model ApproverSession {
  id               String        @id @default(uuid()) @db.Uuid
  approverUserId   String        @db.Uuid @map("approver_user_id")
  webauthnCredentialId String?   @db.Uuid @map("webauthn_credential_id")
  sessionTokenHash String        @unique @db.Char(64) @map("session_token_hash")
  expiresAt        DateTime      @map("expires_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  approverUser     ApproverUser  @relation(fields: [approverUserId], references: [id], onDelete: Cascade)
  webauthnCredential WebauthnCredential? @relation(fields: [webauthnCredentialId], references: [id], onDelete: SetNull)

  @@index([approverUserId, createdAt], map: "approver_sessions_approver_user_id_created_at_idx")
  @@index([expiresAt], map: "approver_sessions_expires_at_idx")
  @@index([webauthnCredentialId, createdAt], map: "approver_sessions_webauthn_credential_id_created_at_idx")
  @@map("approver_sessions")
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String?              @unique
  emailVerified        DateTime?            @map("email_verified")
  image                String?
  activeOrganizationId String?              @map("active_organization_id")
  activeOrganization   Organization?        @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  ownedOrganizations   Organization[]       @relation("OrganizationOwner")
  memberships          OrganizationMember[]
  sentInvitations      OrganizationInvitation[] @relation("OrganizationInviter")
  accounts             Account[]
  sessions             Session[]
  authenticators       Authenticator[]
  createdServiceAccounts ServiceAccount[] @relation("ServiceAccountCreator")
  createdApiKeys       OrganizationApiKey[] @relation("OrganizationApiKeyCreator")

  @@index([activeOrganizationId], map: "dashboard_users_active_organization_id_idx")
  @@map("dashboard_users")
}

model Account {
  userId            String         @map("user_id")
  type              String
  provider          String
  providerAccountId String         @map("provider_account_id")
  refresh_token     String?        @db.Text
  access_token      String?        @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?        @db.Text
  session_state     String?
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId], map: "dashboard_accounts_user_id_idx")
  @@map("dashboard_accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "dashboard_sessions_user_id_idx")
  @@map("dashboard_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("dashboard_verification_tokens")
}

model Authenticator {
  credentialID         String  @unique @map("credential_id")
  userId               String  @map("user_id")
  providerAccountId    String  @map("provider_account_id")
  credentialPublicKey  String  @map("credential_public_key")
  counter              Int
  credentialDeviceType String  @map("credential_device_type")
  credentialBackedUp   Boolean @map("credential_backed_up")
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@index([userId], map: "dashboard_authenticators_user_id_idx")
  @@map("dashboard_authenticators")
}

model ServiceAccount {
  id              String               @id @default(cuid())
  organizationId  String               @map("organization_id")
  name            String
  description     String?
  createdByUserId String?              @map("created_by_user_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  revokedAt       DateTime?            @map("revoked_at")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser   User?                @relation("ServiceAccountCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  apiKeys         OrganizationApiKey[]

  @@index([organizationId, createdAt], map: "service_accounts_org_created_idx")
  @@index([organizationId, revokedAt, createdAt], map: "service_accounts_org_revoked_created_idx")
  @@index([createdByUserId, createdAt], map: "service_accounts_created_by_user_created_idx")
  @@map("service_accounts")
}

model OrganizationApiKey {
  id               String         @id @default(cuid())
  organizationId   String         @map("organization_id")
  serviceAccountId String?        @map("service_account_id")
  name             String
  keyPrefix        String         @unique @map("key_prefix")
  keyHash          String         @unique @db.Char(64) @map("key_hash")
  scopes           ApiKeyScope[]
  createdByUserId  String?        @map("created_by_user_id")
  lastUsedAt       DateTime?      @map("last_used_at")
  revokedAt        DateTime?      @map("revoked_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceAccount   ServiceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: SetNull)
  createdByUser    User?          @relation("OrganizationApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt], map: "organization_api_keys_org_created_idx")
  @@index([organizationId, revokedAt, createdAt], map: "organization_api_keys_org_revoked_created_idx")
  @@index([organizationId, lastUsedAt], map: "organization_api_keys_org_last_used_idx")
  @@index([serviceAccountId, createdAt], map: "organization_api_keys_service_account_created_idx")
  @@index([createdByUserId, createdAt], map: "organization_api_keys_created_by_user_created_idx")
  @@map("organization_api_keys")
}

model OrganizationSubscription {
  id                     String       @id @default(cuid())
  organizationId         String       @unique @map("organization_id")
  provider               String
  providerCustomerId     String?      @map("provider_customer_id")
  providerSubscriptionId String?      @map("provider_subscription_id")
  planCode               String       @map("plan_code")
  status                 String
  currentPeriodEnd       DateTime?    @map("current_period_end")
  providerLastEventId    String?      @map("provider_last_event_id")
  providerLastEventCreatedAt DateTime? @map("provider_last_event_created_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([provider, providerCustomerId], map: "organization_subscriptions_provider_customer_idx")
  @@index([provider, providerSubscriptionId], map: "organization_subscriptions_provider_subscription_idx")
  @@index([provider, providerLastEventCreatedAt], map: "organization_subscriptions_provider_last_event_created_idx")
  @@index([planCode, status], map: "organization_subscriptions_plan_status_idx")
  @@map("organization_subscriptions")
}

model StripeWebhookEventReceipt {
  id                     String        @id @default(cuid())
  organizationId         String?       @map("organization_id")
  providerEventId        String        @unique @map("provider_event_id")
  eventType              String        @map("event_type")
  providerCustomerId     String?       @map("provider_customer_id")
  providerSubscriptionId String?       @map("provider_subscription_id")
  status                 String
  outcomeReason          String?       @map("outcome_reason")
  eventCreatedAt         DateTime      @map("event_created_at")
  processedAt            DateTime?     @map("processed_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt], map: "stripe_webhook_event_receipts_org_created_idx")
  @@index([providerSubscriptionId, eventCreatedAt], map: "stripe_webhook_event_receipts_sub_event_created_idx")
  @@index([status, createdAt], map: "stripe_webhook_event_receipts_status_created_idx")
  @@map("stripe_webhook_event_receipts")
}
