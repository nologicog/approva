# Core API runtime
PORT=4000
APPROVAL_UI_BASE_URL=http://localhost:3000
# Optional extra browser origins allowed to call the API directly with CORS credentials.
# Useful for alternate console origins.
AUTHON_API_ALLOWED_ORIGINS=
CAPABILITY_TTL_MINUTES=15
CAPABILITY_EXCHANGE_TOKEN_TTL_MINUTES=5
APPROVAL_ACCESS_TOKEN_SECRET=change-me-approval-access
# Used for per-request callback signing and as the fallback secret for organization webhook integrations.
WEBHOOK_SIGNING_SECRET=change-me-webhook

# Rate limiting / abuse protection
AUTHON_RATE_LIMIT_ENABLED=true
AUTHON_RATE_LIMIT_GLOBAL=60
AUTHON_RATE_LIMIT_AUTHENTICATED=300
# Optional overrides
AUTHON_RATE_LIMIT_APPROVAL=20
AUTHON_RATE_LIMIT_ORG_APPROVAL_CREATION=120
AUTHON_RATE_LIMIT_ORG_CAPABILITY_VERIFICATION=600
AUTHON_RATE_LIMIT_ORG_WEBHOOK_RETRIES=120
AUTHON_WEBHOOK_REPLAY_WINDOW_SECONDS=300
AUTHON_SENTRY_DSN=

# Runtime mode
AUTHON_RUNTIME_MODE=open-core
AUTHON_SELF_HOST_MODE=true

# Organization / tenancy defaults
# In open-core mode, API requests without an explicit organization header resolve to this org.
AUTHON_DEFAULT_ORGANIZATION_NAME="Default Organization"
AUTHON_DEFAULT_ORGANIZATION_SLUG=default

# Integration secret encryption
# Optional in open-core mode for organization-scoped integrations that store secrets at rest.
AUTHON_INTEGRATION_ENCRYPTION_KEY=

# Approval auth (passkeys / secure approvals)
PASSKEY_RP_NAME=Approva
PASSKEY_RP_ID=localhost
PASSKEY_EXPECTED_ORIGINS=http://localhost:3000
APPROVER_SESSION_TTL_MINUTES=480
PASSKEY_CHALLENGE_TTL_MINUTES=5
# Optional override for the API-hosted approver session cookie. Host-only cookies are the safer default.
APPROVER_SESSION_COOKIE_DOMAIN=

# Transactional email provider
AUTHON_EMAIL_FROM="Approva <no-reply@example.com>"
AUTHON_EMAIL_REPLY_TO=
AUTHON_RESEND_API_KEY=

# Approval notification recipients fallback
# Used only when the active organization has not configured an email integration.
AUTHON_APPROVAL_NOTIFICATION_TO=approver@example.com

# Slack Notifications Beta fallback
# Used only when the active organization has not configured a Slack integration.
AUTHON_SLACK_BOT_TOKEN=
AUTHON_SLACK_CHANNEL_ID=
