# UI / landing / dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional server-side override for containerized deployments where the Next.js app should talk
# to the API over the Docker network instead of the browser-facing host URL.
AUTHON_INTERNAL_API_BASE_URL=
NEXT_PUBLIC_SAMPLE_APPROVER_EMAIL=approver@example.com
# Optional operator-facing release marker shown in the footer and console/system page.
NEXT_PUBLIC_APPROVA_RELEASE="Open Core · 2026.03"
# Backward-compatible alias:
NEXT_PUBLIC_AUTHON_RELEASE=

# Runtime mode
AUTHON_RUNTIME_MODE=open-core
AUTHON_SELF_HOST_MODE=true

# Organization / tenancy defaults
# In open-core mode, the console and API fall back to this default org.
AUTHON_DEFAULT_ORGANIZATION_NAME="Default Organization"
AUTHON_DEFAULT_ORGANIZATION_SLUG=default

# Dashboard auth (Auth.js)
# Optional in open-core mode.
AUTH_SECRET=change-me-dashboard-auth-secret
AUTH_URL=http://localhost:3000

# OAuth providers
# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID OAuth
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional override. Defaults to https://login.microsoftonline.com/common/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Email magic link provider
AUTHON_EMAIL_FROM="Approva <no-reply@example.com>"
AUTHON_EMAIL_REPLY_TO=
AUTHON_RESEND_API_KEY=
# Backward-compatible aliases still work, but AUTHON_EMAIL_FROM / AUTHON_RESEND_API_KEY are preferred.
AUTH_EMAIL_FROM=
AUTH_RESEND_API_KEY=
# Local fallback: if AUTHON_RESEND_API_KEY is unset, magic links are logged by the Next.js server.
